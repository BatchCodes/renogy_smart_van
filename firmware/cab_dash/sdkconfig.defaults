# SPDX-License-Identifier: GPL-3.0-or-later
# Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3: ESP32-P4 (chip revision v3.x), 32 MB flash,
# 32 MB PSRAM, ESP32-C6 co-processor for BLE. For an older v1.x chip, add
# sdkconfig.rev_lt_v3 to SDKCONFIG_DEFAULTS. Refer to docs/renogy_displays/waveshare_p4_43.md.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_OS_FREERTOS=y
# The QIO bootloader is too large for its partition with the default log level.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# 8 MB app partition: the BSP, LVGL, BLE and the camera code need more than 1.5 MB.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# BLE: NimBLE on the P4, controller on the C6 through esp_hosted over SDIO. The
# esp_hosted defaults for the P4 match this board's SDIO pins and C6 reset pin.
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Dashboard fonts.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
