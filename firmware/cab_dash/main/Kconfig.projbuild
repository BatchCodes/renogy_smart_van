# SPDX-License-Identifier: GPL-3.0-or-later
menu "Cab dashboard"

    choice CAB_DASH_MODE
        prompt "Screen"
        default CAB_DASH_MODE_DASHBOARD
        help
            Dashboard: the charging dashboard.
            Test screen: the board bring-up screen with a tap counter and a colour
            bar. Use it to check the display, the rotation and the touch input.
            Camera test: the camera screen only, with frame rate logs. Use it to
            check the USB capture adapter.

        config CAB_DASH_MODE_DASHBOARD
            bool "Dashboard"
        config CAB_DASH_MODE_TEST_SCREEN
            bool "Test screen"
        config CAB_DASH_MODE_CAMERA_TEST
            bool "Camera test"
    endchoice

    choice CAB_DASH_CAMERA_RESOLUTION
        prompt "Camera resolution"
        default CAB_DASH_CAMERA_640X480
        help
            The MJPEG resolution to ask the USB capture adapter for. List the
            adapter's formats on a PC with "v4l2-ctl --list-formats-ext". A PAL
            camera gives 720 x 576.

        config CAB_DASH_CAMERA_640X480
            bool "640 x 480"
        config CAB_DASH_CAMERA_720X480
            bool "720 x 480"
        config CAB_DASH_CAMERA_720X576
            bool "720 x 576 (PAL)"
    endchoice

    config CAB_DASH_CAMERA_WIDTH
        int
        default 720 if CAB_DASH_CAMERA_720X480 || CAB_DASH_CAMERA_720X576
        default 640

    config CAB_DASH_CAMERA_HEIGHT
        int
        default 576 if CAB_DASH_CAMERA_720X576
        default 480

    config CAB_DASH_BACKLIGHT_TIMEOUT_S
        int "Backlight off after no touch for (seconds, 0 = never)"
        range 0 86400
        default 300
        help
            The cab unit is on only when the engine runs. Turn the backlight off
            after this time with no touch, so it does not dazzle at night. A touch
            turns it on again.

    choice CAB_DASH_ROTATION
        prompt "Display rotation"
        default CAB_DASH_ROTATION_90
        help
            The panel is 480 x 800 portrait. The dashboard is landscape. Select
            270 degrees if the image is upside down on your mounting.

        config CAB_DASH_ROTATION_90
            bool "90 degrees"
        config CAB_DASH_ROTATION_270
            bool "270 degrees"
    endchoice

    choice CAB_DASH_SOURCE
        prompt "Data source"
        default CAB_DASH_SOURCE_FAKE
        help
            Fake: simulated values, for testing the dashboard with no BT-2.
            Renogy BT-2: live values from the charger, through BLE on the C6. Set
            the BLE options in the "Renogy BT-2" menu.

        config CAB_DASH_SOURCE_FAKE
            bool "Fake data"
        config CAB_DASH_SOURCE_BT2
            bool "Renogy BT-2"
    endchoice

    config CAB_DASH_POLL_INTERVAL_MS
        int "Data poll interval (milliseconds)"
        range 100 60000
        default 1000
        help
            How often the data task asks the source for a new reading. The BT-2
            source reads the charger at its own poll interval.

    config CAB_DASH_STALE_AFTER_S
        int "Show the data age after (seconds)"
        range 1 86400
        default 30

    config CAB_DASH_OFFLINE_AFTER_S
        int "Show offline after (seconds)"
        range 1 86400
        default 120

    config CAB_DASH_BRIGHTNESS_PERCENT
        int "Backlight brightness (percent)"
        range 5 100
        default 80

endmenu
